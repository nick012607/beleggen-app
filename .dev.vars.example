# Kopie hiervan heet .dev.vars (staat in .gitignore) en is alleen voor lokaal testen van de Worker.
# In productie zet je deze waarden als Worker-secrets:  npx wrangler secret put NAAM
# Nooit in de frontend of in git.

ANTHROPIC_API_KEY=sk-ant-...
FINNHUB_API_KEY=...
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
# Voor web-push (fase 4)
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
